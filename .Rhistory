rownames_to_column("codmpio") %>%
left_join(info_mpio, by = "codmpio") %>%
relocate(municipio, n_mujeres, .after = codmpio)
write_csv(dfb_df, file.path(dir_out, "02_dfbetas.csv"))
# Resumen por parámetro: cuántos municipios superan el umbral y cuál tiene el mayor valor absoluto
resumen_dfb <- tibble(
parametro       = colnames(dfb),
n_superan_corte = colSums(abs(dfb) > corte_dfb),
max_abs_dfbetas = apply(abs(dfb), 2, max),
codmpio_max     = rownames(dfb)[apply(abs(dfb), 2, which.max)]
) %>%
left_join(info_mpio, by = c("codmpio_max" = "codmpio")) %>%
mutate(corte = corte_dfb)
resumen_dfb
write_csv(resumen_dfb, file.path(dir_out, "02_dfbetas_resumen.csv"))
library(tidyverse)
library(here)
library(ggrepel)
dir_out <- here("output", "03_multilevel_model")
dfb <- read_csv(file.path(dir_out, "02_dfbetas.csv"),
col_types = cols(codmpio = col_character()))
corte <- 2 / sqrt(nrow(dfb))   # umbral de Belsley et al.: 2/sqrt(n municipios)
dfb_largo <- dfb %>%
pivot_longer(-c(codmpio, municipio, n_mujeres),
names_to = "parametro", values_to = "dfbetas") %>%
mutate(supera    = abs(dfbetas) > corte,
parametro = factor(parametro, levels = rev(unique(parametro))))
# Municipio más extremo de cada parámetro, si supera el umbral
etiquetas <- dfb_largo %>%
group_by(parametro) %>%
slice_max(abs(dfbetas), n = 1) %>%
filter(supera)
p <- ggplot(dfb_largo, aes(x = dfbetas, y = parametro)) +
geom_vline(xintercept = c(-corte, corte), linetype = "dashed", colour = "grey40") +
geom_point(aes(colour = supera), alpha = 0.5, size = 1.3) +
geom_text_repel(data = etiquetas, aes(label = municipio),
size = 2.5, family = "serif", min.segment.length = 0) +
scale_colour_manual(values = c(`FALSE` = "grey60", `TRUE` = "#D7191C"), guide = "none") +
labs(x = "DFBETAS", y = NULL,
caption = paste0("Cada punto es un municipio. Líneas punteadas: umbral ±", round(corte, 3), ".")) +
theme_bw(base_family = "serif") +
theme(plot.caption = element_text(hjust = 0, colour = "grey40"))
p
ggsave(file.path(dir_out, "02_dfbetas_todos_parametros.png"), p,
width = 9, height = 10, dpi = 300, bg = "white")
# Cuántos municipios superan el umbral en cada parámetro
dfb_largo %>% count(parametro, supera) %>% filter(supera) %>% arrange(desc(n)) %>% print(n = Inf)
# Municipios que superan el umbral en más parámetros
dfb_largo %>%
filter(supera) %>%
count(codmpio, municipio, n_mujeres, name = "n_parametros") %>%
arrange(desc(n_parametros)) %>%
print(n = 20)
